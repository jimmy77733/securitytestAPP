{
  "name": "question-bank-platform",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node scripts/server.mjs",
    "start:standalone": "node scripts/standalone-server.cjs",
    "pack": "npm run build && pkg scripts/standalone-server.cjs --targets node18-win-x64 --output dist-portable/題庫平台.exe && node scripts/hide-console-subsystem.js",
    "pack:full": "npm run pack && node scripts/copy-portable-assets.cjs",
    "pack:mac": "npm run build && pkg scripts/standalone-server.cjs --targets node18-macos-x64,node18-macos-arm64 --output dist-portable/題庫平台-macos",
    "pack:full:mac": "npm run pack:mac && node scripts/copy-portable-assets.cjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "load-questions": "tsx scripts/loadQuestions.ts",
    "validate-questions": "tsx scripts/manualImportHelper.ts",
    "generate-image-manifest": "node scripts/generate-question-image-manifest.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.7",
    "framer-motion": "^10.16.16",
    "lucide-react": "^0.294.0",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "pkg": "^5.8.1"
  }
}
